# Copia este archivo a .env y ajusta si cambias credenciales/puertos.
DATABASE_URL=postgres://tickets:tickets@localhost:5432/tickets
REDIS_URL=redis://localhost:6379

# API key de Zavu (https://dashboard.zavu.dev) para el envío automático de
# WhatsApp desde el botón "Enviar automático (Zavu)". En modo sandbox, Zavu
# solo permite enviar a números verificados en el dashboard (Sandbox →
# Verificar número).
ZAVU_API_KEY=
